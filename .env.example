# 复制为 .env 后填写；已有系统/终端环境变量优先于 .env。
# 模型：填写你自己的千问兼容接口地址和密钥，模型名需在该账号下可用。
# 地址示例：https://dashscope.aliyuncs.com/compatible-mode/v1
# 不要在地址末尾添加 /chat/completions。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-flash

# Telegram：只有使用 --notify 实际发送时才需要填写这两项。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail：将你自己的桌面应用 OAuth JSON 放到此路径，然后运行 auth。
# 这不是普通 API Key；授权成功后 GMAIL_TOKEN_FILE 由程序自动生成。
GMAIL_CREDENTIALS_FILE=credentials/gmail-client.json
GMAIL_TOKEN_FILE=data/gmail-token.json

# 可选：留空则待办写到项目的 todos/；也可填个人目录的绝对路径。
TODO_DIRECTORY=

# 可选：额外邮件/其他通知渠道的 Apprise 配置文件路径。
# 建议放在 credentials/apprise.txt；不需要额外通知渠道时留空。
APPRISE_CONFIG=
